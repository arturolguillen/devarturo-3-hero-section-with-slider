---
import UltraLuxuryExoticDestinationBaliTropicalJungleResortWithInfinityPool from "./../assets/ultra_luxury_exotic_destination_bali_tropical_jungle_resort_with_infinity_pool.png";
---

<div
    class="fixed inset-0 bg-cover bg-center bg-no-repeat transition-all duration-1000 ease-in-out scale-105"
    style={`background-image: url(${UltraLuxuryExoticDestinationBaliTropicalJungleResortWithInfinityPool.src});`}
>
    <div class="absolute inset-0 bg-black/20 backdrop-brightness-90"></div>
    <div class="absolute inset-0 editorial-overlay"></div>
</div>

<style>
    .editorial-overlay {
        background: linear-gradient(
            to bottom,
            rgba(0, 0, 0, 0.3) 0%,
            rgba(0, 0, 0, 0) 30%,
            rgba(0, 0, 0, 0) 70%,
            rgba(0, 0, 0, 0.5) 100%
        );
    }
</style>
