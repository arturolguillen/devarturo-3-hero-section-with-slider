---
const menuItems = [
    { name: "Destinos", href: "#", active: true },
    { name: "Viajes", href: "#", active: false },
    { name: "Acerca de", href: "#", active: false },
    { name: "Contacto", href: "#", active: false },
];
---

<div class="hidden md:flex items-center gap-8">
    {
        menuItems.map((item) => (
            <a
                href={item.href}
                class:list={{
                    "text-xs font-semibold tracking-widest  transition-colors duration-300 uppercase py-1 border-b-2": true,
                    "text-zinc-500 hover:text-emerald-900 border-transparent":
                        item.active === false,
                    "text-emerald-950 border-emerald-950 hover:text-emerald-800":
                        item.active === true,
                }}
            >
                {item.name}
            </a>
        ))
    }
</div>
