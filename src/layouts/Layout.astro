		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Devarturo - Estate</title>
		<Font cssVariable="--font-geist" />
	</head>
	<body
		class="flex flex-col min-h-dvh font-sans antialiased bg-zinc-50 text-zinc-900 selection:bg-emerald-900 selection:text-white"
	>
		<slot />
